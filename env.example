# FeatureMesh Configuration
FEATUREMESHD_IMAGE=ghcr.io/featuremesh/featuremeshd:latest
FEATUREMESH_REGISTRY_URL=https://api.featuremesh.com
FEATUREMESH_SERVING_URL=http://host.docker.internal:10090
FEATUREMESH_REGISTRY_TOKEN=__YOUR_SERVICE_ACCOUNT_TOKEN__
FEATUREMESH_IDENTITY_TOKEN=__YOUR_IDENTITY_TOKEN__

# Database Configuration (compose publishes host ports; jupyter uses service DNS)
POSTGRES_USER=featuremesh
POSTGRES_PASSWORD=featuremesh
POSTGRES_DB=featuremesh
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6380

# Trino (used by libs.helpers.utils.get_trino_config)
TRINO_HOST=host.docker.internal
TRINO_PORT=8081

# Service Ports
FASTAPI_PORT=8010
JUPYTER_PORT=8881

# Inside docker-compose, jupyter overrides hosts/ports to the service network:
#   POSTGRES_HOST=postgres, POSTGRES_PORT=5432, DB_SSL_MODE=disable
#   REDIS_HOST=redis, REDIS_PORT=6379
# Host-published ports above are for featuremeshd / EXTERNAL_* URLs
# (host.docker.internal:5433 / :6380).

# Other settings
BIGQUERY_PROJECT=__YOUR_BIGQUERY_PROJECT__